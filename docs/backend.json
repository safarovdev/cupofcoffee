
{
  "entities": {
    "MenuItem": {
      "title": "Menu Item",
      "description": "Элемент меню кафе (напиток или десерт).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "sizes": { "type": "object" },
        "ingredients": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "time": { "type": "string" }
      },
      "required": ["name", "category", "price"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Пользователь с правами администратора.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Рабочая смена сотрудника.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "number" }
      },
      "required": ["userId", "startTime"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/menu": {
      "schema": "MenuItem",
      "description": "Коллекция всех товаров в меню."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Список разрешенных администраторов. Документ должен иметь ID равный UID пользователя."
    },
    "/shifts": {
      "schema": "Shift",
      "description": "История рабочих смен."
    }
  }
}
